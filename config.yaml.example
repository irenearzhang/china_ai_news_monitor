# China AI News Monitor - Configuration Template
# Copy this file to config.yaml and fill in your email settings

email:
  smtp_server: smtp.gmail.com
  smtp_port: 587
  sender_email: YOUR_EMAIL@gmail.com
  sender_password: YOUR_APP_PASSWORD
  recipient_email: RECIPIENT_EMAIL@gmail.com
  sender_name: China AI News Monitor

monitoring:
  send_time: "08:00"
  timezone: "US/Pacific"
  max_articles_per_category: 15
  # Schedule settings
  days_of_week: [1, 2, 3, 4, 5]  # Monday=1, Friday=5 (weekdays only)
  # Article age limits
  normal_hours: 24  # Articles from last 24 hours (Tue-Fri)
  monday_hours: 72   # Articles from last 72 hours (Monday - covers weekend)

categories:
  ai_releases:
    name: 🤖 New AI Model & Product Releases
    keywords:
    - AI大模型 发布
    - 大模型 发布
    - 文心一言 更新
    - 通义千问 新版本
    - 讯飞星火 发布
    - 智谱AI 新模型
    - 月之暗面 Kimi
    - 零一万物 发布
    - Minimax 发布
    - 阶跃星辰 发布
    - AI 产品 上线
    - 国产大模型 发布
    - OpenAI 中文版
    - Claude AI 发布
    - AI Agent 发布
    - AI 编程 工具
    - AI 搜索 产品
    - 多模态 大模型
    - Sora 视频 生成
    - AI 音乐 生成
    - AI 图像 生成
    sources:
    # Major Tech Media
    - 36氪
    - 量子位
    - 机器之心
    - AI科技评论
    - 澎湃科技
